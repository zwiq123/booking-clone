// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// -----USERS-----

model User {
  id                  Int     @id @default(autoincrement())
  email               String
  firstName           String
  lastName            String
  passwordHash        String
  accountVerified     Boolean
  roleId              Int
  verificationToken   VerificationToken?
  role                Role    @relation(fields: [roleId], references: [id])
  properties          Property[]
  reviews             Review[]

  @@unique([email, roleId])
}

model Role {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users User[]
}

model VerificationToken {
  id              Int     @id @default(autoincrement())
  token           String  @unique
  userId          Int     @unique
  expirationDate  DateTime
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----PROPERTIES-----

model Property {
  id                      Int  @id @default(autoincrement())
  name                    String
  address                 Address?
  rating                  Int?
  
  ownerId                 Int
  owner                   User  @relation(fields: [ownerId], references: [id])
  
  statusId                Int
  status                  PropertyStatus  @relation(fields: [statusId], references: [id])
  
  propertyTypeId          Int
  type                    PropertyType  @relation(fields: [propertyTypeId], references: [id])
  
  propertyDescription     String
  ownerDescription        String
  surroundingsDescription String

  amenities               Amenity[]

  spokenLanguages         Language[]
  images                  Image[]
  reviews                 Review[]
  rooms                   Room[]
}

model PropertyType {
  id          Int @id @default(autoincrement())
  name        String  @unique
  properties  Property[]
}

// draft, published, suspended
model PropertyStatus {
  id          Int @id @default(autoincrement())
  name        String  @unique 
  properties  Property[]
}

// -----ROOMS-----

model Room {
  id              Int @id @default(autoincrement())
  name            String
  propertyId      Int
  property        Property  @relation(fields: [propertyId], references: [id])
  capacity        Int @default(1)
  area            Int?
  smokingAllowed  Boolean @default(false)
  bathroomPrivate Boolean @default(true)
  beds            Bed[]
  amenities       Amenity[]
  pricing         Pricing?
}

model Bed {
  id      Int @id @default(autoincrement())
  typeId  Int
  type    BedType @relation(fields: [typeId], references: [id])
  count   Int @default(1)
  roomId  Int
  room    Room  @relation(fields: [roomId], references: [id])
}

model BedType {
  id    Int @id @default(autoincrement())
  name  String  @unique
  size  String
  beds  Bed[]
}

// -----AMENITIES-----

// many-to-many
model Amenity {
  id              Int @id @default(autoincrement())
  name            String  @unique
  amenityTypeId   Int
  amenityType     AmenityType @relation(fields: [amenityTypeId], references: [id])
  propertyId      Int
  property        Property  @relation(fields: [propertyId], references: [id])
  roomId          Int
  room            Room  @relation(fields: [roomId], references: [id])
}

model AmenityType {
  id          Int @id @default(autoincrement())
  name        String  @unique
  categoryId  Int
  category    AmenityCategory @relation(fields: [categoryId], references: [id])
  amenities   Amenity[]
}

model AmenityCategory {
  id            Int @id @default(autoincrement())
  name          String  @unique
  amenityTypes  AmenityType[]
}

// -----REVIEWS-----

model Review {
  id          Int @id @default(autoincrement())
  rating      Int
  content     String?
  userId      Int
  user        User  @relation(fields: [userId], references: [id])
  propertyId  Int
  property    Property  @relation(fields: [propertyId], references: [id])
}

// -----UTILS-----

model Address {
  id          Int @id @default(autoincrement())
  latitude    Float
  longitude   Float
  country     String
  state       String
  city        String
  postalCode  String
  street      String
  propertyId  Int @unique
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Image {
  id          Int @id @default(autoincrement())
  path        String
  isMain      Boolean @default(false)
  propertyId  Int
  property    Property  @relation(fields: [propertyId], references: [id])
}

// many-to-many
model Language {
  id              Int @id @default(autoincrement())
  languageTypeId  Int
  languageType    LanguageType  @relation(fields: [languageTypeId], references: [id])
  propertyId      Int
  property        Property  @relation(fields: [propertyId], references: [id])
}

model LanguageType {
  id          Int @id @default(autoincrement())
  name        String  @unique
  lanugages   Language[]
}

model Pricing {
  id      Int @id @default(autoincrement())
  price   Float
  roomId  Int   @unique
  Room    Room  @relation(fields: [roomId], references: [id])
  // groups/age prices
}